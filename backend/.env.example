APP_ENV=development
# Local: APP_PORT. Cloud (Render/Railway/Fly): they set PORT automatically.
APP_PORT=8080
# Prefer DATABASE_URL on cloud (Neon/Supabase). Or set discrete DB_* below.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-local-db-password
DB_NAME=krunchies
# Local: disable | Cloud Neon/Supabase: require
DB_SSLMODE=disable
JWT_SECRET=replace-with-a-strong-secret-min-16-chars
# Optional (not required to start the API)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# On-demand website menu ISR (after admin catalog edits)
# WEBSITE_REVALIDATE_URL=https://www.krunchies.pk
# REVALIDATE_SECRET=same-secret-as-website-vercel
# WAHA (self-hosted WhatsApp HTTP API, https://waha.devlike.pro) — order alerts
# + the "text RESET to reset your password" WhatsApp flow. No env = no WhatsApp sends.
# WAHA_BASE_URL=https://your-waha-instance.example.com
# WAHA_API_KEY=
# WAHA_SESSION=default
# Who gets the order alert (comma-separated). 923000128562 is always included too.
# WHATSAPP_OWNER_PHONE=923001234567
